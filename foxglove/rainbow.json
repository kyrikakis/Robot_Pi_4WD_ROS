{
  "configById": {
    "3D!rainbow": {
      "cameraState": {
        "distance": 16,
        "perspective": false,
        "phi": 0,
        "thetaOffset": 0,
        "targetOffset": [
          0,
          0,
          0
        ],
        "target": [
          1.571,
          -3.9,
          0
        ],
        "targetOrientation": [
          0,
          0,
          0,
          1
        ],
        "fovy": 45,
        "near": 0.01,
        "far": 1000
      },
      "followMode": "follow-none",
      "followTf": "map",
      "scene": {
        "transforms": {
          "labelSize": 0.04,
          "axisScale": 0.3,
          "visible": false,
          "showLabel": false
        }
      },
      "transforms": {
        "frame:map": {
          "visible": false
        },
        "frame:odom": {
          "visible": false
        }
      },
      "topics": {
        "/map": {
          "visible": true,
          "colorMode": "map"
        },
        "/global_costmap/costmap": {
          "visible": false,
          "colorMode": "costmap"
        },
        "/local_costmap/costmap": {
          "visible": false,
          "colorMode": "costmap",
          "alpha": 0.6
        },
        "/local_costmap/voxel_grid": {
          "visible": false,
          "pointSize": 4,
          "colorMode": "flat",
          "flatColor": "#ff8000ff"
        },
        "/scan": {
          "visible": true,
          "pointSize": 4,
          "colorMode": "flat",
          "flatColor": "#ff0000ff"
        },
        "/point_cloud": {
          "visible": false,
          "pointSize": 2,
          "colorMode": "colormap",
          "colorField": "z",
          "colorMap": "turbo"
        },
        "/plan": {
          "visible": false
        },
        "/local_costmap/published_footprint": {
          "visible": false
        },
        "/places/markers": {
          "visible": true
        },
        "/plan_viz": {
          "visible": true,
          "lineWidth": 0.02,
          "gradient": [
            "#00ff00ff",
            "#00ff00ff"
          ]
        }
      },
      "layers": {
        "grid": {
          "layerId": "foxglove.Grid",
          "instanceId": "grid",
          "visible": true,
          "frameId": "odom",
          "size": 10,
          "divisions": 20,
          "lineWidth": 1,
          "color": "#248eff40"
        },
        "rainbow-urdf": {
          "layerId": "foxglove.Urdf",
          "instanceId": "rainbow-urdf",
          "label": "Rainbow",
          "visible": true,
          "sourceType": "topic",
          "topic": "/robot_description"
        }
      },
      "publish": {
        "type": "pose",
        "poseTopic": "/goal_pose",
        "pointTopic": "/clicked_point",
        "poseEstimateTopic": "/initialpose",
        "poseEstimateXDeviation": 0.25,
        "poseEstimateYDeviation": 0.25,
        "poseEstimateThetaDeviation": 0.26
      }
    },
    "Teleop!rainbow": {
      "topic": "/cmd_vel_stamped",
      "publishRate": 10,
      "upButton": {
        "field": "linear-x",
        "value": 0.15
      },
      "downButton": {
        "field": "linear-x",
        "value": -0.1
      },
      "leftButton": {
        "field": "angular-z",
        "value": 0.8
      },
      "rightButton": {
        "field": "angular-z",
        "value": -0.8
      }
    },
    "Image!faces": {
      "imageMode": {
        "imageTopic": "/hailo_face_recognition/image_bbx/compressed"
      }
    },
    "RosOut!log": {
      "searchTerms": [],
      "minLogLevel": 3
    },
    "Gauge!battery": {
      "foxglovePanelTitle": "Battery (volts x 10: 69 = 6.9 V empty, 80 = 8.0 V full)",
      "path": "/battery.data",
      "minValue": 69,
      "maxValue": 80,
      "colorMode": "colormap",
      "colorMap": "red-yellow-green",
      "gradient": [
        "#ff0000ff",
        "#00ff00ff"
      ],
      "reverse": false,
      "showTicks": true,
      "tickInterval": 1
    },
    "3D!places": {
      "cameraState": {
        "distance": 8,
        "perspective": false,
        "phi": 0,
        "thetaOffset": 0,
        "targetOffset": [
          0,
          0,
          0
        ],
        "target": [
          0,
          0,
          0
        ],
        "targetOrientation": [
          0,
          0,
          0,
          1
        ],
        "fovy": 45,
        "near": 0.01,
        "far": 1000
      },
      "followMode": "follow-none",
      "followTf": "map",
      "scene": {
        "transforms": {
          "labelSize": 0.04,
          "axisScale": 0.3,
          "visible": false,
          "showLabel": false
        }
      },
      "transforms": {
        "frame:map": {
          "visible": false
        },
        "frame:odom": {
          "visible": false
        }
      },
      "topics": {
        "/map": {
          "visible": true,
          "colorMode": "map"
        },
        "/places/markers": {
          "visible": true
        }
      },
      "layers": {
        "grid": {
          "layerId": "foxglove.Grid",
          "instanceId": "grid",
          "visible": true,
          "frameId": "odom",
          "size": 10,
          "divisions": 20,
          "lineWidth": 1,
          "color": "#248eff40"
        },
        "rainbow-urdf": {
          "layerId": "foxglove.Urdf",
          "instanceId": "rainbow-urdf",
          "label": "Rainbow",
          "visible": true,
          "sourceType": "topic",
          "topic": "/robot_description"
        }
      },
      "publish": {
        "type": "pose",
        "poseTopic": "/places/pick",
        "pointTopic": "/clicked_point",
        "poseEstimateTopic": "/initialpose",
        "poseEstimateXDeviation": 0.25,
        "poseEstimateYDeviation": 0.25,
        "poseEstimateThetaDeviation": 0.26
      }
    },
    "Tab!main": {
      "activeTabIdx": 0,
      "tabs": [
        {
          "title": "Drive",
          "layout": "3D!rainbow"
        },
        {
          "title": "Places",
          "layout": "3D!places"
        },
        {
          "title": "Status",
          "layout": {
            "direction": "row",
            "first": "RawMessages!brain",
            "splitPercentage": 40,
            "second": {
              "direction": "column",
              "splitPercentage": 12,
              "first": {
                "direction": "row",
                "first": "Indicator!agent",
                "second": "Indicator!esp"
              },
              "second": {
                "direction": "column",
                "splitPercentage": 30,
                "first": "Plot!agent",
                "second": {
                  "direction": "column",
                  "splitPercentage": 40,
                  "first": "Plot!health",
                  "second": "RosOut!agent"
                }
              }
            }
          }
        }
      ]
    },
    "CallService!stop": {
      "serviceName": "/brain/stop",
      "requestPayload": "{}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "Stop",
      "buttonTooltip": "Stop in place and cancel every Nav2 goal",
      "buttonColor": "#d32f2f"
    },
    "CallService!relocalize": {
      "serviceName": "/reinitialize_global_localization",
      "requestPayload": "{}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "Relocalize",
      "buttonTooltip": "AMCL forgets its pose and searches the whole map again (then drive or turn a little)",
      "buttonColor": "#ef6c00"
    },
    "CallService!place": {
      "serviceName": "/places/save",
      "requestPayload": "{\n  \"name\": \"kitchen\",\n  \"description\": \"\",\n  \"room\": \"\",\n  \"from_pick\": true,\n  \"guess\": false\n}",
      "layout": "vertical",
      "editingMode": true,
      "buttonText": "Save place",
      "buttonTooltip": "Click a pose in the Places tab first, edit the name, then press",
      "buttonColor": "#2e7d32"
    },
    "RawMessages!brain": {
      "foxglovePanelTitle": "Brain and agent status",
      "topicPath": "/brain/status",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false,
      "expansion": "all"
    },
    "Indicator!agent": {
      "foxglovePanelTitle": "Mac agent",
      "path": "/brain/status.agent.connected",
      "style": "background",
      "fallbackColor": "#a0a0a0",
      "fallbackLabel": "agent offline (local mode)",
      "rules": [
        {
          "operator": "=",
          "rawValue": "true",
          "color": "#68e24a",
          "label": "agent linked"
        }
      ]
    },
    "Indicator!esp": {
      "foxglovePanelTitle": "ESP board (lidar age)",
      "path": "/brain/status.scan_age",
      "style": "background",
      "fallbackColor": "#ff4040",
      "fallbackLabel": "ESP silent (see AGENTS.md: CP2102)",
      "rules": [
        {
          "operator": "<",
          "rawValue": "0",
          "color": "#a0a0a0",
          "label": "no lidar yet"
        },
        {
          "operator": "<",
          "rawValue": "2",
          "color": "#68e24a",
          "label": "ESP ok"
        }
      ]
    },
    "Plot!agent": {
      "foxglovePanelTitle": "Agent: seconds per turn and transcription",
      "paths": [
        {
          "value": "/brain/status.agent.turn_seconds",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "turn"
        },
        {
          "value": "/brain/status.agent.stt_seconds",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "Whisper"
        }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "sidebarDimension": 240
    },
    "Plot!health": {
      "foxglovePanelTitle": "Seconds since the ESP last sent (growing: link down)",
      "paths": [
        {
          "value": "/brain/status.scan_age",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "lidar"
        },
        {
          "value": "/brain/status.odom_age",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "odometry"
        },
        {
          "value": "/brain/status.battery_age",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "battery"
        }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "sidebarDimension": 240
    },
    "RosOut!agent": {
      "foxglovePanelTitle": "Agent log",
      "topicToRender": "/agent/log",
      "searchTerms": [],
      "minLogLevel": 1
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {
    "speed": 1
  },
  "layout": {
    "direction": "row",
    "first": "Tab!main",
    "second": {
      "direction": "column",
      "first": {
        "direction": "column",
        "first": {
          "direction": "row",
          "first": "Teleop!rainbow",
          "second": "Gauge!battery",
          "splitPercentage": 45
        },
        "second": {
          "direction": "row",
          "first": "CallService!stop",
          "second": {
            "direction": "row",
            "first": "CallService!relocalize",
            "second": "CallService!place",
            "splitPercentage": 40
          },
          "splitPercentage": 30
        },
        "splitPercentage": 55
      },
      "second": {
        "direction": "column",
        "first": "Image!faces",
        "second": "RosOut!log",
        "splitPercentage": 55
      },
      "splitPercentage": 55
    },
    "splitPercentage": 62
  }
}
