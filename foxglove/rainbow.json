{
  "configById": {
    "3D!rainbow": {
      "cameraState": {
        "distance": 16,
        "perspective": false,
        "phi": 0,
        "thetaOffset": 0,
        "targetOffset": [
          0,
          0,
          0
        ],
        "target": [
          1.571,
          -3.9,
          0
        ],
        "targetOrientation": [
          0,
          0,
          0,
          1
        ],
        "fovy": 45,
        "near": 0.01,
        "far": 1000
      },
      "followMode": "follow-none",
      "followTf": "map",
      "scene": {
        "transforms": {
          "labelSize": 0.04,
          "axisScale": 0.3,
          "visible": false,
          "showLabel": false
        }
      },
      "transforms": {
        "frame:map": {
          "visible": false
        },
        "frame:odom": {
          "visible": false
        }
      },
      "topics": {
        "/map": {
          "visible": true,
          "colorMode": "map"
        },
        "/global_costmap/costmap": {
          "visible": false,
          "colorMode": "costmap"
        },
        "/local_costmap/costmap": {
          "visible": false,
          "colorMode": "costmap",
          "alpha": 0.6
        },
        "/local_costmap/voxel_grid": {
          "visible": false,
          "pointSize": 4,
          "colorMode": "flat",
          "flatColor": "#ff8000ff"
        },
        "/scan": {
          "visible": true,
          "pointSize": 4,
          "colorMode": "flat",
          "flatColor": "#ff0000ff"
        },
        "/point_cloud": {
          "visible": false,
          "pointSize": 2,
          "colorMode": "colormap",
          "colorField": "z",
          "colorMap": "turbo"
        },
        "/plan": {
          "visible": false
        },
        "/local_costmap/published_footprint": {
          "visible": false
        },
        "/places/markers": {
          "visible": true
        },
        "/plan_viz": {
          "visible": true,
          "lineWidth": 0.02,
          "gradient": [
            "#00ff00ff",
            "#00ff00ff"
          ]
        }
      },
      "layers": {
        "grid": {
          "layerId": "foxglove.Grid",
          "instanceId": "grid",
          "visible": true,
          "frameId": "odom",
          "size": 10,
          "divisions": 20,
          "lineWidth": 1,
          "color": "#248eff40"
        },
        "rainbow-urdf": {
          "layerId": "foxglove.Urdf",
          "instanceId": "rainbow-urdf",
          "label": "Rainbow",
          "visible": true,
          "sourceType": "topic",
          "topic": "/robot_description"
        }
      },
      "publish": {
        "type": "pose",
        "poseTopic": "/goal_pose",
        "pointTopic": "/clicked_point",
        "poseEstimateTopic": "/initialpose",
        "poseEstimateXDeviation": 0.25,
        "poseEstimateYDeviation": 0.25,
        "poseEstimateThetaDeviation": 0.26
      }
    },
    "Teleop!rainbow": {
      "topic": "/cmd_vel_stamped",
      "publishRate": 10,
      "upButton": {
        "field": "linear-x",
        "value": 0.15
      },
      "downButton": {
        "field": "linear-x",
        "value": -0.1
      },
      "leftButton": {
        "field": "angular-z",
        "value": 0.8
      },
      "rightButton": {
        "field": "angular-z",
        "value": -0.8
      }
    },
    "Image!faces": {
      "imageMode": {
        "imageTopic": "/hailo_face_recognition/image_bbx/compressed"
      }
    },
    "RosOut!log": {
      "searchTerms": [],
      "minLogLevel": 2,
      "topicToRender": "/rosout"
    },
    "Gauge!battery": {
      "foxglovePanelTitle": "Battery (volts x 10: 69 = 6.9 V empty, 80 = 8.0 V full)",
      "path": "/battery.data",
      "minValue": 69,
      "maxValue": 80,
      "colorMode": "colormap",
      "colorMap": "red-yellow-green",
      "gradient": [
        "#ff0000ff",
        "#00ff00ff"
      ],
      "reverse": false,
      "showTicks": true,
      "tickInterval": 1
    },
    "3D!places": {
      "cameraState": {
        "distance": 8,
        "perspective": false,
        "phi": 0,
        "thetaOffset": 0,
        "targetOffset": [
          0,
          0,
          0
        ],
        "target": [
          0,
          0,
          0
        ],
        "targetOrientation": [
          0,
          0,
          0,
          1
        ],
        "fovy": 45,
        "near": 0.01,
        "far": 1000
      },
      "followMode": "follow-none",
      "followTf": "map",
      "scene": {
        "transforms": {
          "labelSize": 0.04,
          "axisScale": 0.3,
          "visible": false,
          "showLabel": false
        }
      },
      "transforms": {
        "frame:map": {
          "visible": false
        },
        "frame:odom": {
          "visible": false
        }
      },
      "topics": {
        "/map": {
          "visible": true,
          "colorMode": "map"
        },
        "/places/markers": {
          "visible": true
        }
      },
      "layers": {
        "grid": {
          "layerId": "foxglove.Grid",
          "instanceId": "grid",
          "visible": true,
          "frameId": "odom",
          "size": 10,
          "divisions": 20,
          "lineWidth": 1,
          "color": "#248eff40"
        },
        "rainbow-urdf": {
          "layerId": "foxglove.Urdf",
          "instanceId": "rainbow-urdf",
          "label": "Rainbow",
          "visible": true,
          "sourceType": "topic",
          "topic": "/robot_description"
        }
      },
      "publish": {
        "type": "pose",
        "poseTopic": "/places/pick",
        "pointTopic": "/clicked_point",
        "poseEstimateTopic": "/initialpose",
        "poseEstimateXDeviation": 0.25,
        "poseEstimateYDeviation": 0.25,
        "poseEstimateThetaDeviation": 0.26
      }
    },
    "Tab!main": {
      "activeTabIdx": 0,
      "tabs": [
        {
          "title": "Drive",
          "layout": "3D!rainbow"
        },
        {
          "title": "Places",
          "layout": "3D!places"
        },
        {
          "title": "Status",
          "layout": {
            "direction": "column",
            "splitPercentage": 14,
            "first": {
              "direction": "row",
              "splitPercentage": 50,
              "first": {
                "direction": "row",
                "first": "Indicator!agent",
                "second": "Indicator!esp"
              },
              "second": {
                "direction": "row",
                "first": "Indicator!nav2",
                "second": "Indicator!localization"
              }
            },
            "second": {
              "direction": "column",
              "splitPercentage": 65,
              "first": {
                "direction": "row",
                "splitPercentage": 50,
                "first": "RawMessages!agent",
                "second": "RawMessages!brain"
              },
              "second": "RosOut!agent"
            }
          }
        },
        {
          "title": "Head",
          "layout": {
            "direction": "column",
            "splitPercentage": 30,
            "first": {
              "direction": "row",
              "splitPercentage": 50,
              "first": {
                "direction": "row",
                "first": "CallService!head",
                "second": "CallService!head_center",
                "splitPercentage": 60
              },
              "second": {
                "direction": "row",
                "first": "Indicator!head",
                "second": "CallService!eyes"
              }
            },
            "second": "Plot!head"
          }
        }
      ]
    },
    "CallService!stop": {
      "serviceName": "/brain/stop",
      "requestPayload": "{}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "Stop",
      "buttonTooltip": "Stop in place and cancel every Nav2 goal",
      "buttonColor": "#d32f2f"
    },
    "CallService!relocalize": {
      "serviceName": "/reinitialize_global_localization",
      "requestPayload": "{}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "Relocalize",
      "buttonTooltip": "AMCL forgets its pose and searches the whole map again (then drive or turn a little)",
      "buttonColor": "#ef6c00"
    },
    "CallService!place": {
      "serviceName": "/places/save",
      "requestPayload": "{\n  \"name\": \"kitchen\",\n  \"description\": \"\",\n  \"room\": \"\",\n  \"from_pick\": true,\n  \"guess\": false\n}",
      "layout": "vertical",
      "editingMode": true,
      "buttonText": "Save place",
      "buttonTooltip": "Click a pose in the Places tab first, edit the name, then press",
      "buttonColor": "#2e7d32"
    },
    "RawMessages!brain": {
      "foxglovePanelTitle": "Robot",
      "topicPath": "/brain/status",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false,
      "expansion": "all"
    },
    "Indicator!agent": {
      "foxglovePanelTitle": "Agent",
      "path": "/brain/status.agent.connected",
      "style": "background",
      "fallbackColor": "#a0a0a0",
      "fallbackLabel": "offline",
      "rules": [
        {
          "operator": "=",
          "rawValue": "true",
          "color": "#68e24a",
          "label": "linked"
        }
      ]
    },
    "Indicator!esp": {
      "foxglovePanelTitle": "ESP",
      "path": "/brain/status.scan_age",
      "style": "background",
      "fallbackColor": "#ff4040",
      "fallbackLabel": "silent",
      "rules": [
        {
          "operator": "<",
          "rawValue": "0",
          "color": "#a0a0a0",
          "label": "no lidar yet"
        },
        {
          "operator": "<",
          "rawValue": "2",
          "color": "#68e24a",
          "label": "ok"
        }
      ]
    },
    "RosOut!agent": {
      "foxglovePanelTitle": "Agent log",
      "topicToRender": "/agent/log",
      "searchTerms": [],
      "minLogLevel": 1
    },
    "RawMessages!agent": {
      "foxglovePanelTitle": "Agent",
      "topicPath": "/brain/status.agent",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false,
      "expansion": "all"
    },
    "Indicator!nav2": {
      "foxglovePanelTitle": "Nav2",
      "path": "/brain/status.nav2_ready",
      "style": "background",
      "fallbackColor": "#ff4040",
      "fallbackLabel": "down",
      "rules": [
        {
          "operator": "=",
          "rawValue": "true",
          "color": "#68e24a",
          "label": "ready"
        }
      ]
    },
    "Indicator!localization": {
      "foxglovePanelTitle": "Localization",
      "path": "/brain/status.certainty",
      "style": "background",
      "fallbackColor": "#ff4040",
      "fallbackLabel": "lost or unknown",
      "rules": [
        {
          "operator": "=",
          "rawValue": "sure",
          "color": "#68e24a",
          "label": "sure"
        },
        {
          "operator": "=",
          "rawValue": "roughly",
          "color": "#f5c542",
          "label": "roughly"
        }
      ]
    },
    "CallService!head": {
      "serviceName": "/head/set_pose",
      "requestPayload": "{\n  \"pan\": 0.5,\n  \"tilt\": 0.0\n}",
      "layout": "vertical",
      "editingMode": true,
      "buttonText": "Point head",
      "buttonTooltip": "Radians (0.5 = 29 deg). Pan + = left (-0.70 to 0.66), tilt + = down (-0.63 to 0.33). Smooth move",
      "buttonColor": "#1565c0"
    },
    "CallService!head_center": {
      "serviceName": "/head/center",
      "requestPayload": "{}",
      "layout": "vertical",
      "editingMode": false,
      "buttonText": "Centre head",
      "buttonTooltip": "Back to straight ahead (0, 0)"
    },
    "CallService!eyes": {
      "serviceName": "/eyes/set_expression",
      "requestPayload": "{\n  \"expression\": \"happy\"\n}",
      "layout": "vertical",
      "editingMode": true,
      "buttonText": "Set eyes",
      "buttonTooltip": "happy, open, closed or off"
    },
    "Indicator!head": {
      "foxglovePanelTitle": "Head",
      "path": "/head/moving.data",
      "style": "background",
      "fallbackColor": "#a0a0a0",
      "fallbackLabel": "no head node",
      "rules": [
        {
          "operator": "=",
          "rawValue": "true",
          "color": "#ffb300",
          "label": "moving / settling"
        },
        {
          "operator": "=",
          "rawValue": "false",
          "color": "#68e24a",
          "label": "still"
        }
      ]
    },
    "Plot!head": {
      "foxglovePanelTitle": "Head angles (deg; joints follow the servo commands, a little late)",
      "paths": [
        {
          "value": "/joint_states.position[0].@degrees",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "pan joint"
        },
        {
          "value": "/joint_states.position[1].@degrees",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "tilt joint"
        },
        {
          "value": "/servo_s1.data",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "pan servo (-pan)"
        },
        {
          "value": "/servo_s2.data",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "tilt servo (-tilt - 56)"
        }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 20
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {
    "speed": 1
  },
  "layout": {
    "direction": "row",
    "first": "Tab!main",
    "second": {
      "direction": "column",
      "first": {
        "direction": "column",
        "first": {
          "direction": "row",
          "first": "Teleop!rainbow",
          "second": "Gauge!battery",
          "splitPercentage": 45
        },
        "second": {
          "direction": "row",
          "first": "CallService!stop",
          "second": {
            "direction": "row",
            "first": "CallService!relocalize",
            "second": "CallService!place",
            "splitPercentage": 40
          },
          "splitPercentage": 30
        },
        "splitPercentage": 55
      },
      "second": {
        "direction": "column",
        "first": "Image!faces",
        "second": "RosOut!log",
        "splitPercentage": 55
      },
      "splitPercentage": 55
    },
    "splitPercentage": 62
  }
}
