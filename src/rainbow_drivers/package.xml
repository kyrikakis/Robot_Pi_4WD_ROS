<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rainbow_drivers</name>
  <version>0.1.0</version>
  <description>Rainbow's hardware nodes: head, eyes, ToF, velocity watchdog, IP publisher.</description>
  <maintainer email="kirikakis@gmail.com">Stefanos Kyrikakis</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rainbow_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- Not in rosdep, installed with pip in the Dockerfile:
       adafruit-circuitpython-ht16k33 (eyes), ArducamDepthCamera (tof) -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
